{
	"name": "@foolsecret/pi-pricer",
	"version": "0.11.0",
	"description": "Pi 模型计费配置中心 — 共享价格数据 + 可编辑 UI | Shared model pricing config for Pi extensions",
	"keywords": [
		"pi-package",
		"pi-extension"
	],
	"license": "AGPL-3.0-only",
	"author": "foolsecret <foolsecret@users.noreply.github.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Titor-Z/pi-pricer.git"
	},
	"bugs": {
		"url": "https://github.com/Titor-Z/pi-pricer/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./extensions/index.ts",
	"exports": {
		".": "./extensions/index.ts",
		"./pricing": "./src/pricing-query.ts",
		"./store": "./src/pricing-store.ts",
		"./types": "./src/pricing-types.ts"
	},
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		]
	},
	"files": [
		"src/",
		"extensions/",
		"package.json",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test --test-force-exit test/*.test.mjs",
		"prepublishOnly": "npm run typecheck && npm test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@types/node": "*",
		"jiti": "^2.7.0",
		"typescript": "^5.0.0"
	}
}
