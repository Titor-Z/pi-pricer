{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"declaration": false,
		"outDir": "./dist"
	},
	"include": ["src/**/*.ts", "extensions/**/*.ts"],
	"exclude": ["node_modules", "dist", "test"]
}
